# syntax=docker/dockerfile:1
# Official RavaLink runtime image for Pelican and Pterodactyl.
FROM --platform=$TARGETOS/$TARGETARCH debian:trixie-slim

ARG TARGETARCH
ARG RAVALINK_VERSION

LABEL org.opencontainers.image.title="RavaLink"
LABEL org.opencontainers.image.description="Native Rust Lavalink-compatible audio server for Pelican and Pterodactyl"
LABEL org.opencontainers.image.source="https://github.com/Ravalink-Project/Ravalink"
LABEL org.opencontainers.image.licenses="MIT"

USER root

# Debian Trixie ships a newer glibc than the Debian yolk currently used by
# many panels. The official release binaries are linked against GLIBC 2.39.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl passwd tini bash \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 container \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash container \
    && mkdir -p /data \
    && chown container:container /data

RUN set -eux; \
    test -n "${RAVALINK_VERSION}"; \
    case "${TARGETARCH}" in \
      amd64) asset="ravalink-linux-x86_64" ;; \
      arm64) asset="ravalink-linux-aarch64" ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/Ravalink-Project/Ravalink/releases/download/${RAVALINK_VERSION}"; \
    curl --fail --silent --show-error --location --retry 3 --retry-delay 2 "${base}/SHA256SUMS" -o /tmp/SHA256SUMS; \
    curl --fail --silent --show-error --location --retry 3 --retry-delay 2 "${base}/${asset}" -o /tmp/ravalink; \
    expected="$(awk -v name="${asset}" '($2 == name || $2 == ("*" name)) { print $1; exit }' /tmp/SHA256SUMS)"; \
    test -n "$expected"; \
    printf '%s  %s\n' "$expected" /tmp/ravalink | sha256sum --check --status; \
    install -m 0755 /tmp/ravalink /usr/local/bin/ravalink; \
    rm -f /tmp/ravalink /tmp/SHA256SUMS

# Pelican/Wings expects a yolk-style entrypoint to expand STARTUP and
# keep the server process attached to the container console.
RUN cat > /entrypoint.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

cd /home/container

if [[ -z "${STARTUP:-}" ]]; then
    echo "[RavaLink] ERROR: STARTUP is empty; refusing to leave an idle container." >&2
    exit 64
fi

# Expand Pelican's {{VARIABLE}} placeholders without sed/regex escaping.
MODIFIED_STARTUP="${STARTUP//\{\{/\$\{}"
MODIFIED_STARTUP="${MODIFIED_STARTUP//\}\}/\}}"
eval "MODIFIED_STARTUP=\"$MODIFIED_STARTUP\""

echo ":/home/container$ $MODIFIED_STARTUP"
exec bash -lc "$MODIFIED_STARTUP"
EOF
RUN chmod 0755 /entrypoint.sh

ENV USER=container HOME=/home/container
WORKDIR /home/container
USER container

# Keep the OAuth refresh token outside the ephemeral application directory.
# Pelican/Pterodactyl's Docker runtime can mount this path as persistent storage.
VOLUME ["/data"]

ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["/entrypoint.sh"]

EXPOSE 2333/tcp
